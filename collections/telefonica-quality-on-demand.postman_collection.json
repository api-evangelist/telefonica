    "_postman_id": "ed73ce24-8fd7-4011-89e8-16215ea49c91",
    "name": "Telefónica Quality on Demand API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Quality on Demand (QoD) API provides applications with precise control over mobile network connectivity quality, enabling guaranteed bandwidth and low-latency profiles for specific device sessions. Used for real-time communications, video streaming, industrial IoT, autonomous systems, and gaming. Based on CAMARA open standards. Available in Spain, Germany, and Brazil.",
      "type": "text/plain"
    }
  }

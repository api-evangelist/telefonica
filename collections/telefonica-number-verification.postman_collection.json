  "info": {
    "_postman_id": "d060bba6-89e1-450c-b9c9-62acbf2fbe13",
    "name": "Telefónica Number Verification API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Number Verification API enables automatic verification that users interact via devices with SIM cards associated with their phone numbers. Based on the CAMARA open standard developed by the GSMA Open Gateway initiative. Eliminates the need for credential entry or OTPs by using carrier network data to confirm the mobile number actively connected to the network matches the claimed number.",
      "type": "text/plain"
    }
  }

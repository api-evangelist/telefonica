  "info": {
    "_postman_id": "674b1ffe-5511-4b43-851b-ae73e608f234",
    "name": "Telefónica Know Your Customer Match API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The KYC Match API validates a user's contact information against reliable mobile carrier data, enabling quick identity verification without sharing sensitive personal data. Returns match/no-match results for name, address, phone number, email, and date of birth fields. Used for KYC compliance, e-commerce fraud prevention, and financial services identity verification. Based on CAMARA open standards. Available in Spain, Germany, Brazil, and UK.",
      "type": "text/plain"
    }
  }

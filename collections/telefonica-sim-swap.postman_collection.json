  "info": {
    "_postman_id": "62f001e2-0d0e-4f0e-8879-5927f213ae91",
    "name": "Telefónica SIM Swap API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The SIM Swap API enables applications to check whether a SIM swap occurred recently on a mobile number. SIM swap fraud is a common attack where criminals take over a victim's phone number to bypass SMS-based 2FA. Based on CAMARA open standards. Available in Spain, Germany, Brazil, and the United Kingdom through the Telefónica Open Gateway.",
      "type": "text/plain"
    }
  }

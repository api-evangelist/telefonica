          "name": "Check SIM Swap",
          "request": {
            "name": "Check SIM Swap",
            "description": {
              "content": "Checks whether a SIM swap occurred on the specified phone number within a given time period. Returns a boolean indicating if a recent SIM swap was detected.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "sim-swap",
                "check"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
